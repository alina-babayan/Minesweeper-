QMainWindow {
    background-color: #2c3e50;
}

QLabel#WelcomeTitle {
    color: #ecf0f1;
    font-size: 32px;
    font-weight: bold;
}

QLabel#ChooseDiff {
    color: #bdc3c7;
    font-size: 18px;
}

QPushButton {
    color: #ecf0f1;
    background-color: #34495e;
    border-radius: 12px;
    min-width: 200px;
    min-height: 60px;
    font-size: 16px;
}

QPushButton:hover {
    background-color: #5d6d7e;
}

QPushButton:pressed {
    background-color: #1abc9c;
}

QPushButton#HowToPlayBtn, QPushButton#AboutBtn {
    color: #2c3e50;
    background-color: #ecf0f1;
    border-radius: 10px;
    min-width: 160px;
    min-height: 45px;
}

QPushButton#HowToPlayBtn:hover, QPushButton#AboutBtn:hover {
    background-color: #d0d3d4;
}

QPushButton#HowToPlayBtn:pressed, QPushButton#AboutBtn:pressed {
    background-color: #b0b7b7;
}
